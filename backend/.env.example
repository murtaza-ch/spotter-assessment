# Local settings work without this file. Copy it to .env when overriding defaults.
DJANGO_SECRET_KEY=development-only-change-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
TOMTOM_API_KEY=
# DATABASE_URL=postgres://spotter:spotter@127.0.0.1:5432/spotter

# Production requires config.settings.production, a strong private secret,
# explicit allowed hosts, and a DATABASE_URL. See docs/architecture.md.
